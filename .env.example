# Application
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000
API_PREFIX=v1/api

# Database (postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=badrgo
DB_SYNC=true
DB_LOGGING=false

# Auth
JWT_SECRET_KEY=change-me-in-production
JWT_EXPIRES_IN=7d

# Localization
FALLBACK_LANGUAGE=en-us

# Seeded super admin
SUPER_ADMIN_EMAIL=admin@badrgo.dev
SUPER_ADMIN_PASSWORD=Admin@12345
