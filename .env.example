# Application
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000
API_PREFIX=v1/api

# Database (postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=badrgo
DB_SYNC=true
DB_LOGGING=false

# Auth
JWT_SECRET_KEY=change-me-in-production
JWT_EXPIRES_IN=7d

# Localization
FALLBACK_LANGUAGE=en-us

# Seeded super admin
SUPER_ADMIN_EMAIL=admin@badrgo.dev
SUPER_ADMIN_PASSWORD=Admin@12345

# Services (TCP)
USER_SERVICE_HOST=localhost
USER_SERVICE_PORT=4001
WALLET_SERVICE_HOST=localhost
WALLET_SERVICE_PORT=4002
REPORT_SERVICE_HOST=localhost
REPORT_SERVICE_PORT=4003
SERVICE_TIMEOUT_MS=5000

# Per-service HTTP ports (gateway uses APP_PORT)
USER_HTTP_PORT=3001
REPORT_HTTP_PORT=3003

# Per-service databases
WALLET_DB_DATABASE=badrgo_wallet
REPORT_DB_DATABASE=badrgo_report

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=badrgo
OUTBOX_POLL_MS=2000

# ClickHouse (analytics store — consumes Kafka directly)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=badrgo
CLICKHOUSE_TIMEOUT_MS=10000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX=badrgo:
REDIS_TTL=60
IDEMPOTENCY_TTL=86400
RATE_LIMIT=100
RATE_LIMIT_WINDOW=60
